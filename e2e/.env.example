# Copie para .env e ajuste para o seu ambiente.

# URL do frontend (dev server do Vite)
BASE_URL=http://localhost:5173

# Email/senha de um usuário existente para os testes que usam login direto.
# Se TEST_EMAIL ficar em branco, o spec faz registro de um novo usuário a cada run.
TEST_EMAIL=
TEST_PASSWORD=Teste1234!
